{% schema %}
{
  "name": "Popup Builder",
  "target": "body",
  "javascript": "popup.js",
  "stylesheet": "popup.css",
  "settings": [
    {
      "type": "text",
      "id": "popup_name",
      "label": "Specific Popup Name",
      "info": "Optional: Enter the exact name of the popup (e.g. 'New Year Sale') to only show that popup on this theme."
    }
  ]
}
{% endschema %}

<script>
  window.PopupBuilderConfig = {
    shopDomain: "{{ shop.domain }}",
    apiUrl: "/apps/popup-builder",
    designMode: {{ request.design_mode | default: false }},
    template: "{{ template.name | default: 'index' }}",
    targetPopupName: "{{ block.settings.popup_name | escape | default: '' }}"
  };
</script>

<div id="popup-builder-container" {{ block.shopify_attributes }}></div>
