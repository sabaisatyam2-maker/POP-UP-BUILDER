{% schema %}
{
  "name": "Popup Builder",
  "target": "body",
  "javascript": "popup.js",
  "stylesheet": "popup.css",
  "settings": []
}
{% endschema %}

<script>
  window.PopupBuilderConfig = {
    shopDomain: "{{ shop.domain }}",
    apiUrl: "/apps/popup-builder",
    designMode: {{ request.design_mode | default: false }},
    template: "{{ template.name | default: 'index' }}"
  };
</script>

<div id="popup-builder-container" {{ block.shopify_attributes }}></div>
